# LLM API Keys (optional — pipeline runs 100% offline with --mock)
# Free Tier Alternatives:
GEMINI_API_KEY=               # Google AI Studio (Free tier available: https://aistudio.google.com/apikey)
GROQ_API_KEY=                 # Groq (Free fast Llama 3.3 / Qwen: https://console.groq.com/keys)
OPENROUTER_API_KEY=           # OpenRouter (Aggregator with free models: https://openrouter.ai/keys)
OPENAI_API_KEY=               # OpenAI (Paid: https://platform.openai.com/api-keys)
DASHSCOPE_API_KEY=            # Alibaba Cloud Qwen (Paid/Trial: https://dashscope.console.aliyun.com/)

# Guardrail Configuration
GUARDRAIL_UNCONDITIONAL_SEMANTIC=true # true for unconditional LLM semantic classification; false for heuristic-gated cascade

# Team Authentication & RBAC (optional — defaults to built-in seed keys for testing)
# Format: "user_id:api_key:role1|role2,user_id2:api_key2:role1"
TEAM_API_KEYS=alice_admin:demo-team-admin-key-not-for-production:admin|operator|reader,bob_engineer:demo-team-engineer-key-not-for-production:operator|reader,charlie_intern:demo-team-readonly-key-not-for-production:reader